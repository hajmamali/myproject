{
  "dashboard": {
    "id": null,
    "uid": "governance-kernel-overview",
    "title": "MAHOUN Governance Kernel - Overview",
    "description": "Real-time monitoring dashboard for the MAHOUN Governance Kernel runtime",
    "tags": ["mahoun", "governance", "kernel", "security"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(governance_initialized, instance)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "options": [],
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          }
        },
        {
          "name": "namespace",
          "type": "query", 
          "query": "label_values(governance_initialized, kubernetes_namespace)",
          "refresh": 1,
          "includeAll": false,
          "multi": false,
          "options": [],
          "current": {
            "selected": false,
            "text": "mahoun-governance",
            "value": "mahoun-governance"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "increase(kube_deployment_status_replicas_updated{deployment=\"governance-kernel\"}[1m]) > 0",
          "iconColor": "rgb(0, 96, 255)",
          "titleFormat": "Deployment Update"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "🛡️ Governance Status Overview",
        "type": "stat",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "governance_initialized{instance=~\"$instance\"}",
            "legendFormat": "{{instance}} - Initialized",
            "refId": "A"
          },
          {
            "expr": "governance_enforcement_enabled{instance=~\"$instance\"}",
            "legendFormat": "{{instance}} - Enforcement",
            "refId": "B"
          },
          {
            "expr": "up{job=\"governance-kernel\", instance=~\"$instance\"}",
            "legendFormat": "{{instance}} - Health",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"type": "value", "value": "0", "text": "❌ DOWN"},
              {"type": "value", "value": "1", "text": "✅ UP"}
            ]
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,
        "title": "📊 Request Rate & Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"governance-kernel\", instance=~\"$instance\"}[1m])",
            "legendFormat": "{{instance}} - {{method}} {{path}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps",
            "min": 0
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 3,
        "title": "🔒 Security Metrics",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "increase(governance_change_attempts{instance=~\"$instance\"}[1m])",
            "legendFormat": "{{instance}} - Bypass Attempts",
            "refId": "A"
          },
          {
            "expr": "rate(http_requests_total{job=\"governance-kernel\", instance=~\"$instance\", code=~\"4..|5..\"}[1m])",
            "legendFormat": "{{instance}} - Error Rate",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "min": 0
          }
        },
        "alert": {
          "conditions": [
            {
              "query": {"queryType": "", "refId": "A"},
              "reducer": {"type": "last", "params": []},
              "evaluator": {"params": [0], "type": "gt"}
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "10s",
          "handler": 1,
          "name": "Governance Bypass Attempt",
          "noDataState": "no_data",
          "message": "🚨 Governance bypass attempt detected!"
        }
      },
      {
        "id": 4,
        "title": "💾 Resource Utilization",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"governance-kernel\", instance=~\"$instance\"} / 1024 / 1024",
            "legendFormat": "{{instance}} - Memory (MB)",
            "refId": "A"
          },
          {
            "expr": "rate(process_cpu_seconds_total{job=\"governance-kernel\", instance=~\"$instance\"}[1m]) * 100",
            "legendFormat": "{{instance}} - CPU %",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "min": 0
          }
        }
      },
      {
        "id": 5,
        "title": "⚡ Response Time Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "targets": [
          {
            "expr": "rate(http_request_duration_seconds_bucket{job=\"governance-kernel\", instance=~\"$instance\"}[1m])",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ],
        "options": {
          "calculate": true,
          "calculation": {
            "xBuckets": {
              "mode": "count",
              "value": "50"
            }
          },
          "cellGap": 2,
          "color": {
            "exponent": 0.5,
            "fill": "dark-orange",
            "mode": "scheme",
            "reverse": false,
            "scale": "exponential",
            "scheme": "Oranges",
            "steps": 128
          },
          "exemplars": {
            "color": "rgba(255,0,255,0.7)"
          },
          "filterValues": {
            "le": 1e-9
          },
          "legend": {
            "show": true
          },
          "rowsFrame": {
            "layout": "auto"
          },
          "showValue": "never",
          "tooltip": {
            "show": true,
            "yHistogram": false
          },
          "yAxis": {
            "axisPlacement": "left",
            "reverse": false,
            "unit": "s"
          }
        }
      },
      {
        "id": 6,
        "title": "📈 Throughput by Endpoint",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"governance-kernel\", instance=~\"$instance\"}[1m])) by (path)",
            "legendFormat": "{{path}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-GrYlRd"},
            "unit": "reqps",
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 100}
              ]
            }
          }
        },
        "options": {
          "displayMode": "gradient",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "showUnfilled": true
        }
      },
      {
        "id": 7,
        "title": "🏥 Health Check Status",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "governance_initialized{instance=~\"$instance\"}",
            "legendFormat": "",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "instance": "Instance",
                "mode": "Governance Mode",
                "Value": "Status"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"type": "value", "value": "0", "text": "❌ Not Initialized"},
              {"type": "value", "value": "1", "text": "✅ Initialized"}
            ]
          }
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "desc": false,
              "displayName": "Instance"
            }
          ]
        }
      },
      {
        "id": 8,
        "title": "📊 Error Rate by Status Code",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"governance-kernel\", instance=~\"$instance\"}[1m])) by (code)",
            "legendFormat": "{{code}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps",
            "mappings": [
              {"type": "regex", "options": {"pattern": "2..", "result": {"color": "green"}}},
              {"type": "regex", "options": {"pattern": "4..", "result": {"color": "yellow"}}},
              {"type": "regex", "options": {"pattern": "5..", "result": {"color": "red"}}}
            ]
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "pieType": "pie",
          "tooltip": {"mode": "single", "sort": "none"},
          "legend": {
            "displayMode": "visible",
            "placement": "right",
            "values": ["value", "percent"]
          }
        }
      }
    ]
  },
  "overwrite": true,
  "message": "Updated MAHOUN Governance Kernel dashboard",
  "folderUid": "mahoun-governance",
  "inputs": [
    {
      "name": "DS_PROMETHEUS",
      "type": "datasource",
      "pluginId": "prometheus",
      "value": "Prometheus"
    }
  ]
}