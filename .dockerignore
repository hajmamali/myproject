# Reasoning & LLM Components (NOT needed in governance kernel)
mahoun/reasoning/
mahoun/llm/ 
mahoun/rag/
mahoun/retrieval/
mahoun/pipelines/
mahoun/agents/
mahoun/domain/
mahoun/finetuning/
mahoun/self_improve/
mahoun/nlp/
mahoun/orchestrator/
mahoun/graph/gnn/
mahoun/graph/training/
mahoun/graph/optimizer/
mahoun/ultra_systems/

# Infrastructure services (separate containers)
mahoun/infrastructure/
mahoun/monitoring/
mahoun/metrics/
mahoun/dashboard/
mahoun/bootstrap/

# Development & testing  
tests/
docs/
reports/
frontend/
reasoning_logic/

# Custom Project Exclusions (MAHOUN-Specific)
# ============================================================================

# Legacy containers (being replaced)
Dockerfile.backend  # Deprecated monolith

# Kiro IDE files
.kiro/
.kilocode/
.kilo/
.antigravitycli/

# Cursor IDE
.cursor/

# Devin AI
.devin/

# Custom analysis files (potentially sensitive)
.test_classification_backup/
CONTAINER_CONSOLIDATION_AUDIT.md
DATABASE_USAGE_ANALYSIS.md  
DOCKER_SMART_CLEANUP_PLAN.md
ENTERPRISE_STACK_GUIDE.md
ENTERPRISE_MONITORING_COMPLETION_REPORT.md
INFRASTRUCTURE_AUDIT_BRUTAL.md

# Development scripts (keep in repo, exclude from images)
scripts/manage_enterprise_stack.sh
scripts/monitoring_stack_manager.sh
scripts/container_security_scan.sh

# ============================================================================
# Security Scanning Exclusions (Tools Generate Large Files)
# ============================================================================
.trivyignore
trivy-results.json
grype-results.json
snyk-results.json
security-scan-*
vulnerability-report-*

# ============================================================================
# Performance Testing & Benchmarks
# ============================================================================
benchmark-results/
performance-reports/
load-test-results/
profiling-data/
*.prof
*.perf

# ============================================================================
# Backup Files (Prevent Accidental Inclusion)
# ============================================================================
*.bak
*.backup
*.old
*.orig
*.save
*~

# Database backups
*.dump
*.sql.gz
*.sql.bz2

# Configuration backups
config.*.bak
settings.*.old

# ============================================================================
# Final Notes
# ============================================================================
# This .dockerignore is designed to:
# 1. Maximize security by excluding sensitive files
# 2. Optimize build performance by reducing context size  
# 3. Prevent accidental leakage of development artifacts
# 4. Maintain clean, minimal production images
# 
# Review and update regularly as project structure evolves.
# Always test build contexts after modifications.
# ============================================================================