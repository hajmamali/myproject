[run]
source = mahoun, api
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */.venv/*
    */migrations/*
    */experimental/*
    # Experimental modules (excluded from core coverage)
    mahoun/self_improve/*
    mahoun/flows/*
    mahoun/ultra_systems/*
    mahoun/research/*
    mahoun/prototypes/*

[report]
precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov

[json]
output = coverage.json
