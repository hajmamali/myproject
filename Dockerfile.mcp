# ============================================================================
# MAHOUN MCP Service - Ultra-Lightweight Model Context Protocol Server
# ============================================================================
# Purpose: MCP server for AI agent integrations and tool registry  
# Target Size: <100MB (minimal footprint)
# Security: Hardened, non-root, restricted capabilities
# Performance: Async I/O optimized, memory efficient
# ============================================================================

ARG PYTHON_VERSION=3.12.7
ARG ALPINE_VERSION=3.19

# ============================================================================
# Stage 1: MCP Dependencies Builder
# ============================================================================
FROM python:${PYTHON_VERSION}-alpine${ALPINE_VERSION} AS mcp-builder

WORKDIR /build

# Install minimal build dependencies for MCP
RUN apk add --no-cache --virtual .build-deps \
    gcc \
    musl-dev \
    libffi-dev \
    && apk add --no-cache \
    curl \
    ca-certificates

# Create ultra-minimal requirements for MCP server only
RUN cat > requirements-mcp.txt << 'EOF'
# MCP Core (Model Context Protocol)
mcp>=1.0.0,<2.0.0

# Async HTTP server
aiohttp>=3.9.0,<4.0.0
aiofiles>=23.2.0,<24.0.0

# JSON-RPC 2.0 implementation
jsonrpc-base>=2.2.0,<3.0.0
jsonrpc-async>=2.1.2,<3.0.0

# WebSocket support
websockets>=12.0,<13.0

# Data validation (minimal)
pydantic>=2.6.0,<3.0.0

# Async utilities
asyncio-mqtt>=0.16.0,<1.0.0
tenacity>=8.2.0,<9.0.0

# Fast JSON processing
orjson>=3.9.0,<4.0.0

# Monitoring (minimal)
prometheus-client>=0.19.0,<0.20.0

# Logging
loguru>=0.7.2,<0.8.0

# Security (minimal)
cryptography>=42.0.0,<43.0.0

# Configuration
pydantic-settings>=2.1.0,<3.0.0
EOF

# Install MCP dependencies with optimization
RUN pip install --no-cache-dir --user \
    --no-warn-script-location \
    --disable-pip-version-check \
    --compile \
    -r requirements-mcp.txt

# ============================================================================
# Stage 2: Runtime - Ultra-minimal MCP service
# ============================================================================
FROM python:${PYTHON_VERSION}-alpine${ALPINE_VERSION} AS runtime

# Security: Create dedicated MCP service user with minimal privileges
RUN addgroup -g 1002 mcpuser \
    && adduser -u 1002 -G mcpuser -s /bin/sh -D mcpuser \
    && mkdir -p /app/tools /app/config /app/logs /tmp/mcp \
    && chown -R mcpuser:mcpuser /app /tmp/mcp \
    && chmod 755 /app \
    && chmod 700 /app/config /app/logs /tmp/mcp

WORKDIR /app

# Install only essential runtime packages (absolute minimum)
RUN apk add --no-cache \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Copy Python packages from builder
COPY --from=mcp-builder --chown=mcpuser:mcpuser \
    /root/.local /home/mcpuser/.local

# Copy minimal MCP-related code only
COPY --chown=mcpuser:mcpuser \
    mahoun/mcp/ ./mahoun/mcp/

# Copy essential core modules for tool registry
COPY --chown=mcpuser:mcpuser \
    mahoun/core/models.py \
    mahoun/core/exceptions.py \
    mahoun/core/protocols.py \
    ./mahoun/core/

# Create MCP server implementation
RUN cat > /app/mcp-server.py << 'EOF'
#!/usr/bin/env python3
"""
MAHOUN MCP Server - Model Context Protocol Implementation
Purpose: Provides AI agent tools and context management
Architecture: Async JSON-RPC 2.0 server with WebSocket support
"""

import os
import sys
import json
import asyncio
import signal
from typing import Dict, List, Any, Optional, Union
from dataclasses import dataclass
from pathlib import Path

import aiohttp
from aiohttp import web, WSMsgType
import websockets
from loguru import logger
import orjson
from pydantic import BaseModel, Field
from prometheus_client import Counter, Histogram, generate_latest

# Configure structured logging for MCP
logger.configure(
    handlers=[
        {
            "sink": sys.stdout,
            "format": "{time:YYYY-MM-DD HH:mm:ss} | {level} | MCP | {name}:{function}:{line} | {message}",
            "level": os.getenv("LOG_LEVEL", "INFO")
        }
    ]
)

# Metrics
mcp_requests = Counter('mcp_requests_total', 'Total MCP requests', ['method', 'status'])
mcp_duration = Histogram('mcp_request_duration_seconds', 'MCP request duration', ['method'])

# MCP Protocol Models
class MCPRequest(BaseModel):
    """JSON-RPC 2.0 request model"""
    jsonrpc: str = "2.0"
    id: Union[str, int, None] = None
    method: str
    params: Optional[Dict[str, Any]] = None

class MCPResponse(BaseModel):
    """JSON-RPC 2.0 response model"""
    jsonrpc: str = "2.0"
    id: Union[str, int, None] = None
    result: Optional[Dict[str, Any]] = None
    error: Optional[Dict[str, Any]] = None

class MCPTool(BaseModel):
    """MCP tool definition"""
    name: str
    description: str
    input_schema: Dict[str, Any]
    capabilities: List[str] = Field(default_factory=list)

class MCPError:
    """MCP error codes"""
    PARSE_ERROR = -32700
    INVALID_REQUEST = -32600
    METHOD_NOT_FOUND = -32601
    INVALID_PARAMS = -32602
    INTERNAL_ERROR = -32603

class MCPToolRegistry:
    """Registry for MCP tools and capabilities"""
    
    def __init__(self):
        self.tools: Dict[str, MCPTool] = {}
        self.initialize_core_tools()
    
    def initialize_core_tools(self):
        """Initialize core MAHOUN tools"""
        
        # Legal reasoning tool
        self.register_tool(MCPTool(
            name="legal_reasoning",
            description="Perform legal document reasoning with evidence linking",
            input_schema={
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Legal query to analyze"},
                    "documents": {
                        "type": "array", 
                        "items": {"type": "string"},
                        "description": "Document IDs to analyze"
                    },
                    "correlation_id": {"type": "string", "description": "Request correlation ID"}
                },
                "required": ["query", "correlation_id"]
            },
            capabilities=["reasoning", "evidence_linking", "legal_analysis"]
        ))
        
        # Document search tool
        self.register_tool(MCPTool(
            name="document_search",
            description="Search legal documents with hybrid retrieval",
            input_schema={
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                    "filters": {"type": "object", "description": "Search filters"},
                    "limit": {"type": "integer", "default": 10, "description": "Result limit"}
                },
                "required": ["query"]
            },
            capabilities=["search", "retrieval", "ranking"]
        ))
        
        # Graph query tool
        self.register_tool(MCPTool(
            name="graph_query",
            description="Query legal knowledge graph",
            input_schema={
                "type": "object", 
                "properties": {
                    "cypher": {"type": "string", "description": "Cypher query (read-only)"},
                    "entity_id": {"type": "string", "description": "Entity to explore"}
                }
            },
            capabilities=["graph_traversal", "relationship_analysis"]
        ))
        
        # Health check tool
        self.register_tool(MCPTool(
            name="system_health",
            description="Check MAHOUN system health status",
            input_schema={
                "type": "object",
                "properties": {
                    "component": {"type": "string", "description": "Specific component to check"}
                }
            },
            capabilities=["monitoring", "diagnostics"]
        ))
        
        logger.info(f"Initialized {len(self.tools)} core MCP tools")
    
    def register_tool(self, tool: MCPTool):
        """Register a new tool"""
        self.tools[tool.name] = tool
        logger.debug(f"Registered MCP tool: {tool.name}")
    
    def get_tool(self, name: str) -> Optional[MCPTool]:
        """Get tool by name"""
        return self.tools.get(name)
    
    def list_tools(self) -> List[MCPTool]:
        """List all available tools"""
        return list(self.tools.values())

class MCPServer:
    """MCP Server implementation"""
    
    def __init__(self):
        self.registry = MCPToolRegistry()
        self.sessions: Dict[str, Dict] = {}
    
    async def handle_request(self, request_data: Dict) -> Dict:
        """Handle MCP JSON-RPC request"""
        
        try:
            # Parse request
            req = MCPRequest(**request_data)
            
            with mcp_duration.labels(method=req.method).time():
                # Route request to handler
                if req.method == "initialize":
                    result = await self.handle_initialize(req.params or {})
                elif req.method == "tools/list":
                    result = await self.handle_list_tools()
                elif req.method == "tools/call":
                    result = await self.handle_call_tool(req.params or {})
                elif req.method == "capabilities":
                    result = await self.handle_capabilities()
                else:
                    mcp_requests.labels(method=req.method, status="error").inc()
                    return self.create_error_response(req.id, MCPError.METHOD_NOT_FOUND, 
                                                    f"Method not found: {req.method}")
                
                mcp_requests.labels(method=req.method, status="success").inc()
                return self.create_response(req.id, result)
                
        except Exception as e:
            logger.error(f"MCP request handling error: {e}")
            mcp_requests.labels(method="unknown", status="error").inc()
            return self.create_error_response(None, MCPError.INTERNAL_ERROR, str(e))
    
    async def handle_initialize(self, params: Dict) -> Dict:
        """Handle MCP initialization"""
        session_id = params.get("sessionId", "default")
        
        self.sessions[session_id] = {
            "initialized_at": asyncio.get_event_loop().time(),
            "client_info": params.get("clientInfo", {}),
            "capabilities": params.get("capabilities", {})
        }
        
        logger.info(f"MCP session initialized: {session_id}")
        
        return {
            "protocolVersion": "2024-11-05",
            "capabilities": {
                "tools": {"listChanged": True},
                "logging": {"level": "info"},
                "sampling": {"enabled": False}
            },
            "serverInfo": {
                "name": "mahoun-mcp-server",
                "version": "1.0.0",
                "description": "MAHOUN Model Context Protocol Server"
            }
        }
    
    async def handle_list_tools(self) -> Dict:
        """Handle tool listing request"""
        tools = []
        
        for tool in self.registry.list_tools():
            tools.append({
                "name": tool.name,
                "description": tool.description,
                "inputSchema": tool.input_schema
            })
        
        return {"tools": tools}
    
    async def handle_call_tool(self, params: Dict) -> Dict:
        """Handle tool call request"""
        tool_name = params.get("name")
        arguments = params.get("arguments", {})
        
        if not tool_name:
            raise ValueError("Tool name is required")
        
        tool = self.registry.get_tool(tool_name)
        if not tool:
            raise ValueError(f"Tool not found: {tool_name}")
        
        # Route to specific tool implementation
        if tool_name == "legal_reasoning":
            result = await self.execute_legal_reasoning(arguments)
        elif tool_name == "document_search":
            result = await self.execute_document_search(arguments)
        elif tool_name == "graph_query":
            result = await self.execute_graph_query(arguments)
        elif tool_name == "system_health":
            result = await self.execute_system_health(arguments)
        else:
            raise ValueError(f"Tool implementation not found: {tool_name}")
        
        return {"content": [{"type": "text", "text": orjson.dumps(result).decode()}]}
    
    async def handle_capabilities(self) -> Dict:
        """Handle capabilities request"""
        return {
            "capabilities": [
                "legal_reasoning",
                "document_search", 
                "graph_traversal",
                "system_monitoring"
            ],
            "version": "1.0.0",
            "tools_count": len(self.registry.tools)
        }
    
    async def execute_legal_reasoning(self, args: Dict) -> Dict:
        """Execute legal reasoning tool (stub implementation)"""
        return {
            "status": "success",
            "message": "Legal reasoning tool executed",
            "query": args.get("query"),
            "correlation_id": args.get("correlation_id"),
            "note": "Full implementation requires API service integration"
        }
    
    async def execute_document_search(self, args: Dict) -> Dict:
        """Execute document search tool (stub implementation)"""
        return {
            "status": "success", 
            "message": "Document search executed",
            "query": args.get("query"),
            "results_count": 0,
            "note": "Full implementation requires search service integration"
        }
    
    async def execute_graph_query(self, args: Dict) -> Dict:
        """Execute graph query tool (stub implementation)"""
        return {
            "status": "success",
            "message": "Graph query executed", 
            "query_type": "read_only",
            "note": "Full implementation requires Neo4j integration"
        }
    
    async def execute_system_health(self, args: Dict) -> Dict:
        """Execute system health check"""
        return {
            "status": "healthy",
            "service": "mcp-server",
            "uptime": asyncio.get_event_loop().time(),
            "tools_available": len(self.registry.tools),
            "sessions_active": len(self.sessions)
        }
    
    def create_response(self, request_id: Union[str, int, None], result: Dict) -> Dict:
        """Create JSON-RPC response"""
        return {
            "jsonrpc": "2.0",
            "id": request_id,
            "result": result
        }
    
    def create_error_response(self, request_id: Union[str, int, None], 
                            code: int, message: str) -> Dict:
        """Create JSON-RPC error response"""
        return {
            "jsonrpc": "2.0", 
            "id": request_id,
            "error": {
                "code": code,
                "message": message
            }
        }

# Global MCP server instance
mcp_server = MCPServer()

async def handle_http_mcp(request):
    """Handle HTTP MCP requests"""
    try:
        body = await request.json()
        result = await mcp_server.handle_request(body)
        return web.json_response(result)
    except Exception as e:
        logger.error(f"HTTP MCP error: {e}")
        return web.json_response({
            "jsonrpc": "2.0",
            "id": None,
            "error": {"code": MCPError.INTERNAL_ERROR, "message": str(e)}
        }, status=500)

async def handle_websocket_mcp(request):
    """Handle WebSocket MCP connections"""
    ws = web.WebSocketResponse()
    await ws.prepare(request)
    
    logger.info("WebSocket MCP connection established")
    
    async for msg in ws:
        if msg.type == WSMsgType.TEXT:
            try:
                data = orjson.loads(msg.data)
                result = await mcp_server.handle_request(data)
                await ws.send_text(orjson.dumps(result).decode())
            except Exception as e:
                logger.error(f"WebSocket MCP error: {e}")
                error_response = {
                    "jsonrpc": "2.0",
                    "id": None,
                    "error": {"code": MCPError.INTERNAL_ERROR, "message": str(e)}
                }
                await ws.send_text(orjson.dumps(error_response).decode())
        elif msg.type == WSMsgType.ERROR:
            logger.error(f"WebSocket error: {ws.exception()}")
    
    logger.info("WebSocket MCP connection closed")
    return ws

async def handle_health(request):
    """Health check endpoint"""
    health_data = await mcp_server.execute_system_health({})
    return web.json_response(health_data)

async def handle_metrics(request):
    """Prometheus metrics endpoint"""
    return web.Response(text=generate_latest(), content_type="text/plain")

def create_app():
    """Create aiohttp application"""
    app = web.Application()
    
    # MCP endpoints
    app.router.add_post('/mcp', handle_http_mcp)
    app.router.add_get('/mcp/ws', handle_websocket_mcp)
    
    # Service endpoints
    app.router.add_get('/health', handle_health)
    app.router.add_get('/metrics', handle_metrics)
    
    return app

def signal_handler(signum, frame):
    """Graceful shutdown handler"""
    logger.info(f"Received signal {signum}, shutting down MCP server...")
    sys.exit(0)

if __name__ == "__main__":
    # Register signal handlers
    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)
    
    # Create and start server
    app = create_app()
    
    logger.info("🔧 MAHOUN MCP Server starting...")
    
    web.run_app(
        app,
        host="0.0.0.0",
        port=8001,
        access_log=logger if os.getenv("MAHOUN_ENV") == "development" else None
    )
EOF

# Make MCP server executable
RUN chmod +x /app/mcp-server.py

# Set proper environment and path
ENV PATH="/home/mcpuser/.local/bin:$PATH" \
    PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MAHOUN_SERVICE="mcp"

# Security: Switch to non-root user
USER mcpuser:mcpuser

# Expose MCP port
EXPOSE 8001

# Health check for MCP service
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# MCP server entrypoint
CMD ["python", "mcp-server.py"]

# ============================================================================ 
# Build optimization labels
# ============================================================================
LABEL maintainer="MAHOUN Platform Team" \
      service="mcp-server" \
      version="1.0.0" \
      description="MAHOUN MCP Server - Model Context Protocol implementation" \
      org.opencontainers.image.source="https://github.com/mahoun/platform" \
      org.opencontainers.image.description="MCP server microservice" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="Proprietary"