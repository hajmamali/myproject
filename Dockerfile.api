# ============================================================================
# MAHOUN API Service - Ultra-Optimized FastAPI Container
# ============================================================================
# Purpose: Pure FastAPI service with reasoning capabilities
# Target Size: <200MB (vs 1.2GB monolith)  
# Security: Hardened, non-root, minimal dependencies
# Performance: Multi-stage build, layer optimization, caching
# ============================================================================

ARG PYTHON_VERSION=3.12.7
ARG ALPINE_VERSION=3.19

# ============================================================================
# Stage 1: Base Dependencies Builder
# ============================================================================
FROM python:${PYTHON_VERSION}-alpine${ALPINE_VERSION} AS base-builder

WORKDIR /build

# Install build dependencies for compilation
RUN apk add --no-cache --virtual .build-deps \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    postgresql-dev \
    rust \
    cargo \
    && apk add --no-cache \
    curl \
    ca-certificates \
    postgresql-client

# ============================================================================
# Stage 2: Python Dependencies Builder  
# ============================================================================
FROM base-builder AS deps-builder

# Create optimized requirements for API service only
RUN cat > requirements-api.txt << 'EOF'
# Core FastAPI stack
fastapi>=0.104.1,<0.105.0
uvicorn[standard]>=0.24.0,<0.25.0
starlette>=0.27.0,<0.28.0

# Data validation & serialization
pydantic>=2.6.0,<3.0.0  
pydantic-settings>=2.1.0,<3.0.0

# HTTP client for internal service calls
httpx>=0.27.0,<0.28.0
aiohttp>=3.9.0,<4.0.0

# Database drivers
asyncpg>=0.29.0,<0.30.0
redis[hiredis]>=5.0.0,<6.0.0

# Security & Authentication
python-jose[cryptography]>=3.3.0,<4.0.0
passlib[bcrypt]>=1.7.4,<2.0.0
cryptography>=42.0.0,<43.0.0
PyNaCl>=1.5.0,<2.0.0

# Monitoring & Observability
prometheus-client>=0.19.0,<0.20.0
loguru>=0.7.2,<0.8.0
python-json-logger>=2.0.7,<3.0.0
opentelemetry-api>=1.20.0,<2.0.0
opentelemetry-sdk>=1.20.0,<2.0.0
opentelemetry-instrumentation-fastapi>=0.41b0,<1.0.0

# Async utilities
asyncio-mqtt>=0.16.0,<1.0.0
tenacity>=8.2.0,<9.0.0

# Performance & Optimization  
orjson>=3.9.0,<4.0.0
ujson>=5.8.0,<6.0.0
uvloop>=0.19.0,<1.0.0
httptools>=0.6.0,<1.0.0

# Rate limiting
slowapi>=0.1.9,<0.2.0

# CORS & middleware
python-multipart>=0.0.6,<1.0.0

# Development & Testing (minimal set)
pytest>=8.3.0,<9.0.0
pytest-asyncio>=0.24.0,<1.0.0
httpx>=0.27.0,<0.28.0
EOF

# Install Python dependencies with optimization flags
RUN pip install --no-cache-dir --user \
    --no-warn-script-location \
    --disable-pip-version-check \
    --compile \
    -r requirements-api.txt

# ============================================================================
# Stage 3: Runtime - Ultra-minimal API service
# ============================================================================  
FROM python:${PYTHON_VERSION}-alpine${ALPINE_VERSION} AS runtime

# Security: Create dedicated API service user
RUN addgroup -g 1000 apiuser \
    && adduser -u 1000 -G apiuser -s /bin/sh -D apiuser \
    && mkdir -p /app/data /app/uploads /app/logs /tmp/api \
    && chown -R apiuser:apiuser /app /tmp/api \
    && chmod 755 /app \
    && chmod 700 /app/data /app/uploads /app/logs /tmp/api

WORKDIR /app

# Install only essential runtime packages
RUN apk add --no-cache \
    curl \
    ca-certificates \
    tzdata \
    postgresql-client \
    && rm -rf /var/cache/apk/*

# Copy Python packages from builder
COPY --from=deps-builder --chown=apiuser:apiuser \
    /root/.local /home/apiuser/.local

# Copy API application code (strict minimal subset)
COPY --chown=apiuser:apiuser api/ ./api/

# Copy required reasoning modules (minimal dependency tree)
COPY --chown=apiuser:apiuser \
    mahoun/core/ ./mahoun/core/
COPY --chown=apiuser:apiuser \
    mahoun/reasoning/ ./mahoun/reasoning/
COPY --chown=apiuser:apiuser \
    mahoun/schemas/ ./mahoun/schemas/
COPY --chown=apiuser:apiuser \
    mahoun/infrastructure/health/ ./mahoun/infrastructure/health/
COPY --chown=apiuser:apiuser \
    mahoun/security/ ./mahoun/security/
COPY --chown=apiuser:apiuser \
    mahoun/monitoring/ ./mahoun/monitoring/

# Copy configuration
COPY --chown=apiuser:apiuser config/ ./config/
COPY --chown=apiuser:apiuser pyproject.toml ./

# Create API service startup script with governance integration
RUN cat > /app/start-api.py << 'EOF'
#!/usr/bin/env python3
"""
MAHOUN API Service - FastAPI Application with Governance Integration
Purpose: REST API endpoints with governance-aware request handling
"""

import os
import sys
import asyncio
import signal
from contextlib import asynccontextmanager
from typing import Optional

import uvicorn
from fastapi import FastAPI, Request, HTTPException, Depends
from fastapi.middleware.cors import CORSMiddleware
from fastapi.middleware.trustedhost import TrustedHostMiddleware
from fastapi.responses import JSONResponse
from loguru import logger
import httpx

# Configure structured logging
logger.configure(
    handlers=[
        {
            "sink": sys.stdout,
            "format": "{time:YYYY-MM-DD HH:mm:ss} | {level} | API | {name}:{function}:{line} | {message}",
            "level": os.getenv("LOG_LEVEL", "INFO")
        }
    ]
)

class GovernanceClient:
    """Client for communicating with governance kernel"""
    
    def __init__(self, governance_url: str = "http://governance-kernel:8080"):
        self.governance_url = governance_url
        self.client: Optional[httpx.AsyncClient] = None
    
    async def start(self):
        """Initialize HTTP client"""
        self.client = httpx.AsyncClient(
            base_url=self.governance_url,
            timeout=httpx.Timeout(5.0),
            limits=httpx.Limits(max_connections=10, max_keepalive_connections=5)
        )
    
    async def stop(self):
        """Cleanup HTTP client"""
        if self.client:
            await self.client.aclose()
    
    async def check_governance(self, query_type: str, correlation_id: str, 
                             actor_id: str, resource_id: str = None) -> bool:
        """Check governance validation"""
        if not self.client:
            logger.warning("Governance client not initialized - allowing request")
            return True
        
        try:
            response = await self.client.post("/v1/governance/enforce", json={
                "query_type": query_type,
                "correlation_id": correlation_id,
                "actor_id": actor_id,
                "resource_id": resource_id,
                "metadata": {}
            })
            
            if response.status_code == 200:
                result = response.json()
                return result.get("allowed", False)
            else:
                logger.error(f"Governance check failed: {response.status_code}")
                return False
                
        except httpx.RequestError as e:
            logger.error(f"Governance service unavailable: {e}")
            # Fail-safe: block on governance errors in production
            return os.getenv("MAHOUN_ENV") != "production"

# Global governance client
governance = GovernanceClient()

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifecycle management with governance integration"""
    logger.info("🚀 MAHOUN API Service starting...")
    
    # Initialize governance client
    await governance.start()
    
    # Health check governance service
    if governance.client:
        try:
            response = await governance.client.get("/health")
            if response.status_code == 200:
                logger.success("✅ Governance service connected")
            else:
                logger.warning("⚠️ Governance service unhealthy")
        except Exception as e:
            logger.warning(f"⚠️ Cannot connect to governance service: {e}")
    
    logger.success("✅ API Service initialized")
    yield
    
    logger.info("🔄 API Service shutting down...")
    await governance.stop()
    logger.info("✅ API Service shutdown complete")

# Create FastAPI application
app = FastAPI(
    title="MAHOUN API Service",
    description="FastAPI service with governance-aware request handling",
    version="1.0.0",
    docs_url="/docs" if os.getenv("MAHOUN_ENV") != "production" else None,
    redoc_url=None,
    openapi_url="/openapi.json" if os.getenv("MAHOUN_ENV") != "production" else None,
    lifespan=lifespan
)

# Security middleware
app.add_middleware(
    TrustedHostMiddleware,
    allowed_hosts=[
        "localhost", 
        "api-server", 
        "*.mahoun.internal",
        os.getenv("MAHOUN_ALLOWED_HOST", "*")
    ]
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=os.getenv("CORS_ORIGINS", "http://localhost:3000").split(","),
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE"],
    allow_headers=["*"],
)

async def get_governance_context(request: Request):
    """Extract governance context from request"""
    return {
        "correlation_id": request.headers.get("X-Correlation-ID", "unknown"),
        "actor_id": request.headers.get("X-Actor-ID", "anonymous"),
        "resource_id": request.path_info
    }

@app.middleware("http")
async def governance_middleware(request: Request, call_next):
    """Governance enforcement middleware"""
    
    # Skip governance for health checks and metrics
    if request.url.path in ["/health", "/metrics", "/docs", "/openapi.json"]:
        return await call_next(request)
    
    # Extract governance context
    context = await get_governance_context(request)
    
    # Check governance for write operations
    if request.method in ["POST", "PUT", "DELETE", "PATCH"]:
        allowed = await governance.check_governance(
            query_type=f"{request.method}:{request.url.path}",
            correlation_id=context["correlation_id"],
            actor_id=context["actor_id"],
            resource_id=context["resource_id"]
        )
        
        if not allowed:
            logger.warning(f"Governance denied: {request.method} {request.url.path}")
            return JSONResponse(
                status_code=403,
                content={
                    "error": "Governance violation", 
                    "message": "Operation not permitted",
                    "correlation_id": context["correlation_id"]
                }
            )
    
    # Process request
    response = await call_next(request)
    
    # Add governance headers
    response.headers["X-Governance-Validated"] = "true"
    response.headers["X-Correlation-ID"] = context["correlation_id"]
    
    return response

@app.get("/health")
async def health_check():
    """Comprehensive health check"""
    
    # Check governance service connectivity
    governance_healthy = False
    if governance.client:
        try:
            response = await governance.client.get("/health", timeout=2.0)
            governance_healthy = response.status_code == 200
        except Exception:
            pass
    
    return {
        "status": "healthy",
        "service": "api-server",
        "governance_connected": governance_healthy,
        "version": "1.0.0"
    }

@app.get("/metrics")
async def metrics():
    """Prometheus metrics endpoint"""
    from prometheus_client import generate_latest
    from fastapi import Response
    return Response(generate_latest(), media_type="text/plain")

# Import and register API routers
try:
    from api.routers import reasoning, search, system, health_v2
    
    app.include_router(reasoning.router, prefix="/api/v1", tags=["reasoning"])
    app.include_router(search.router, prefix="/v1", tags=["search"])
    app.include_router(system.router, prefix="/system", tags=["system"])
    app.include_router(health_v2.router, prefix="/health", tags=["health"])
    
    logger.info("✅ API routers registered")
    
except ImportError as e:
    logger.warning(f"⚠️ Some API routers not available: {e}")

@app.get("/")
async def root():
    """Root endpoint"""
    return {
        "service": "mahoun-api",
        "version": "1.0.0",
        "status": "operational",
        "governance": "enabled"
    }

def signal_handler(signum, frame):
    """Graceful shutdown on signals"""
    logger.info(f"Received signal {signum}, shutting down...")
    sys.exit(0)

if __name__ == "__main__":
    # Register signal handlers for graceful shutdown
    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)
    
    # Start server
    # v5.1 Integrity Closure (BL-1): the production container MUST execute the
    # exact same governed application that the test suite imports
    # (api.main:app). Running a locally-defined "start-api:app" reintroduced the
    # "Certification Surface != Execution Surface" divergence. Do NOT revert.
    uvicorn.run(
        "api.main:app",
        host="0.0.0.0",
        port=8000,
        workers=1,
        loop="uvloop",
        http="httptools",
        log_level=os.getenv("LOG_LEVEL", "info").lower(),
        access_log=os.getenv("MAHOUN_ENV") == "development",
        reload=False,
        proxy_headers=True,
        forwarded_allow_ips="*"
    )
EOF

# Make startup script executable
RUN chmod +x /app/start-api.py

# Set proper environment and path
ENV PATH="/home/apiuser/.local/bin:$PATH" \
    PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MAHOUN_SERVICE="api"

# Security: Switch to non-root user
USER apiuser:apiuser

# Expose API port
EXPOSE 8000

# Health check with governance awareness
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# API service entrypoint
CMD ["python", "start-api.py"]

# ============================================================================
# Build optimization labels
# ============================================================================
LABEL maintainer="MAHOUN Platform Team" \
      service="api-server" \
      version="1.0.0" \
      description="MAHOUN API Service - FastAPI with governance integration" \
      org.opencontainers.image.source="https://github.com/mahoun/platform" \
      org.opencontainers.image.description="API service microservice" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="Proprietary"